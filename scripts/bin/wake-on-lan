#!/usr/bin/env bash

hosts=(
	"FLDW-2509"
	"WNDG-2011"
)

declare -A macs=(
	["FLDW-2509"]="9c:6b:00:84:34:93"
	["WNDG-2011"]="A8:A1:59:3B:77:BC"
)

echo "==== WoL Hosts ===="

PS3="Select Host: "

select host in "${hosts[@]}"; do
	[[ -n "$host" ]] || continue

	wakeonlan "${macs[$host]}"
	break
done
